{
  "name": "@feedbacker/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env src/server.ts",
    "serve:fixture": "ALLOWED_PRODUCT_ORIGINS=http://app.fixture.localhost:3001 PORT=3000 node --env-file-if-exists=../../.env src/server.ts",
    "db:migrate": "node --env-file-if-exists=../../.env src/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@feedbacker/contracts": "workspace:*",
    "fastify": "^5.12.8",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0"
  }
}
